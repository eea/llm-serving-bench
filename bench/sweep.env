# Sweep definition shared by bench/run.sh (override any of these in the shell).
# Keep one file per sweep shape so historical sweeps are reproducible.

# Length grid used by all 2026-08 runs. Note the odd 2045 output length: it is
# what was actually run in August 2026 and the reason for it was never recorded.
# New sweeps should probably use 2048 for a clean grid.
INPUT_LENS="128 512 1024 2048"
OUTPUT_LENS="128 512 1024 2045"

# Requests per scenario. 100 concurrent requests, request-rate left at its
# default (inf) => saturation test, not an SLO test.
PROMPTS=100

# Bench client image. The *server* image is pinned in bench/serve/<model>.yml.
VLLM_IMAGE="vllm/vllm-openai:v0.25.0"

# Dataset
DATASET="random"
BACKEND="openai"
